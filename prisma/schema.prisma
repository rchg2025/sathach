generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             Int              @id @default(autoincrement())
  username       String           @unique
  password       String
  name           String
  phone          String?
  email          String?
  role           String // "ADMIN", "MANAGER", "EXAMINER"
  isActive       Boolean          @default(true)
  avatarUrl      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  assignments    TestAssignment[]
  managedTests   TestResult[]     @relation("StationManagerTests")
  examProgress   ExamProgress[]
  resetOtp       String?
  resetOtpExpiry DateTime?
  isOnline       Boolean          @default(false)
  lastPingAt     DateTime?
  logs           SystemLog[]
  students              Student[]              @relation("StudentTeacher")
  trainingRegistrations TrainingRegistration[]
  advancePaymentRequests AdvancePaymentRequest[]
  teacherRates          TeacherRateConfig[]

  @@index([role])
}

model SystemLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  action    String // 'LOGIN' or 'LOGOUT'
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Student {
  id                Int     @id @default(autoincrement())
  registrationCode  String? // Mã ĐK
  name              String // Họ tên
  dob               String? // Ngày sinh
  cccd              String  @unique // CCCD
  address           String? // Địa chỉ
  licenseNumber     String? // Số GPLX
  licenseClass      String? // Hạng
  licenseIssueDate  String? // Ngày cấp
  passDate          String? // Ngày trúng tuyển
  licenseExpiryDate String? // Ngày hết hạn
  licenseDuration   String? // Thời gian GPLX

  testStationOrder  String? // Custom test order, comma separated names or IDs

  courseName  String? // Tên khóa học (Raw from Excel)
  courseId    Int?
  course      Course?      @relation(fields: [courseId], references: [id])
  teacherId   Int?
  teacher     User?        @relation("StudentTeacher", fields: [teacherId], references: [id])
  tuitionInfo StudentTuition?
  testResults TestResult[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  RetakeSession RetakeSession[]

  @@index([courseId])
  @@index([courseName])
  @@index([name])
}

model Course {
  id             Int              @id @default(autoincrement())
  name           String
  description    String?
  startDate      DateTime?
  endDate        DateTime?
  isCompleted    Boolean          @default(false)
  students       Student[]
  assignments    TestAssignment[]
  retakeSessions RetakeSession[]
  tuitionConfigs TuitionFeeConfig[]
  advanceRequests AdvancePaymentRequest[]
  teacherRates   TeacherRateConfig[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model VehicleType {
  id                Int              @id @default(autoincrement())
  name              String
  description       String?
  seats             Int?
  brand             String?
  owner             String?
  manufacturingYear Int?
  inspectionExpiry  DateTime?
  contractStart     DateTime?
  contractEnd       DateTime?
  isActive          Boolean          @default(true)
  testResults       TestResult[]
  assignments       TestAssignment[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model TestType {
  id           Int              @id @default(autoincrement())
  name         String
  description  String?
  maxScore     Float              @default(100)
  passingScore Float              @default(80)
  exams        Exam[]
  assignments  TestAssignment[]
  testResults  TestResult[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model Exam {
  id          Int              @id @default(autoincrement())
  name        String
  description String?
  testTypeId  Int
  testType    TestType         @relation(fields: [testTypeId], references: [id])
  criteria    Criterion[]
  assignments TestAssignment[]
  progress    ExamProgress[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([testTypeId])
}

model Criterion {
  id             Int     @id @default(autoincrement())
  name           String
  pointsToDeduct Float     @default(5)
  examId         Int
  exam           Exam    @relation(fields: [examId], references: [id])
  scores         Score[]

  @@index([examId])
}

model TestAssignment {
  id             Int           @id @default(autoincrement())
  examinerId     Int
  examiner       User          @relation(fields: [examinerId], references: [id])
  testTypeId     Int
  testType       TestType      @relation(fields: [testTypeId], references: [id])
  examId         Int?
  exam           Exam?         @relation(fields: [examId], references: [id])
  courseId       Int?
  course         Course?       @relation(fields: [courseId], references: [id])
  vehicles       VehicleType[]
  assignmentDate DateTime?
  showScore      Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt

  @@index([examinerId])
  @@index([courseId])
  @@index([testTypeId])
  @@index([assignmentDate])
}

model TestResult {
  id               Int            @id @default(autoincrement())
  studentId        Int
  student          Student        @relation(fields: [studentId], references: [id])
  testTypeId       Int
  testType         TestType       @relation(fields: [testTypeId], references: [id])
  vehicleId        Int?
  vehicle          VehicleType?   @relation(fields: [vehicleId], references: [id])
  totalScore       Float            @default(100)
  status           String         @default("PENDING") // PENDING, PASSED, FAILED
  startTime        DateTime?
  endTime          DateTime?
  stationManagerId Int?
  stationManager   User?          @relation("StationManagerTests", fields: [stationManagerId], references: [id])
  scores           Score[]
  progress         ExamProgress[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([studentId])
  @@index([testTypeId])
  @@index([status])
  @@index([createdAt])
}

model Score {
  id            Int        @id @default(autoincrement())
  testResultId  Int
  testResult    TestResult @relation(fields: [testResultId], references: [id])
  criterionId   Int
  criterion     Criterion  @relation(fields: [criterionId], references: [id])
  timesDeducted Int        @default(1)
  createdAt     DateTime   @default(now())

  @@index([testResultId])
  @@index([criterionId])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ExamProgress {
  id           Int        @id @default(autoincrement())
  testResultId Int
  testResult   TestResult @relation(fields: [testResultId], references: [id])
  examId       Int
  exam         Exam       @relation(fields: [examId], references: [id])
  examinerId   Int
  examiner     User       @relation(fields: [examinerId], references: [id])
  status       String     @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  startTime    DateTime?
  endTime      DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([testResultId, examId])
  @@index([examinerId])
  @@index([status])
}

model RetakeSession {
  id             Int      @id @default(autoincrement())
  studentId      Int
  student        Student  @relation(fields: [studentId], references: [id])
  targetCourseId Int
  targetCourse   Course   @relation(fields: [targetCourseId], references: [id])
  createdAt      DateTime @default(now())

  @@unique([studentId, targetCourseId])
  @@index([studentId])
  @@index([targetCourseId])
}

model TrainingGround {
  id        Int      @id @default(autoincrement())
  name      String
  address   String
  phone     String?
  email     String?
  mapUrl    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions  TrainingSession[]
}

model TrainingShift {
  id        Int      @id @default(autoincrement())
  name      String
  startTime String?
  endTime   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions  TrainingSession[]
}

model TrainingSession {
  id                    Int                    @id @default(autoincrement())
  trainingGroundId      Int
  trainingGround        TrainingGround         @relation(fields: [trainingGroundId], references: [id])
  trainingShiftId       Int
  trainingShift         TrainingShift          @relation(fields: [trainingShiftId], references: [id])
  vehicles              String         
  date                  DateTime
  examDate              DateTime?
  startTime             String?
  endTime               String?
  registrationStartTime DateTime?
  registrationEndTime   DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  registrations         TrainingRegistration[]

  @@index([date])
  @@index([trainingGroundId])
  @@index([trainingShiftId])
}

model TrainingRegistration {
  id                Int             @id @default(autoincrement())
  trainingSessionId Int
  trainingSession   TrainingSession @relation(fields: [trainingSessionId], references: [id])
  userId            Int
  user              User            @relation(fields: [userId], references: [id])
  vehicle           String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([trainingSessionId, vehicle])
  @@index([userId])
}

// ==========================================
// QUẢN LÝ HỌC PHÍ, TẠM ỨNG & THANH TOÁN
// ==========================================

model TuitionFeeConfig {
  id                 Int      @id @default(autoincrement())
  courseId           Int
  course             Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  transmissionType   String   // 'AUTO' (Số tự động), 'MANUAL' (Số sàn)
  scheduleType       String   // 'WEEKDAY' (Ngày thường), 'SUNDAY' (Chủ nhật / Cuối tuần)
  tuitionAmount      Float    @default(0) // Mức học phí (VNĐ)
  teacherSharePercent Float   @default(0) // Tỉ lệ % giáo viên được hưởng (VD: 60 = 60%)
  teacherShareAmount  Float?  @default(0) // Hoặc số tiền cố định/học viên (nếu áp dụng tiền mặt)
  note               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  studentTuitions    StudentTuition[]

  @@unique([courseId, transmissionType, scheduleType])
  @@index([courseId])
}

model StudentTuition {
  id                 Int              @id @default(autoincrement())
  studentId          Int              @unique
  student            Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tuitionConfigId    Int?
  tuitionConfig      TuitionFeeConfig? @relation(fields: [tuitionConfigId], references: [id], onDelete: SetNull)
  transmissionType   String           @default("MANUAL") // 'AUTO' | 'MANUAL'
  scheduleType       String           @default("WEEKDAY") // 'WEEKDAY' | 'SUNDAY'
  tuitionAmount      Float            @default(0) // Học phí thực tế
  teacherSharePercent Float           @default(0) // Tỷ lệ hưởng %
  teacherEarnedAmount Float           @default(0) // Tiền thù lao GV được tính cho HV này
  isPaid             Boolean          @default(false) // Đã đóng học phí hay chưa
  paidAmount         Float            @default(0) // Số tiền học viên đã đóng
  note               String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([studentId])
  @@index([tuitionConfigId])
}

model DeductionCategory {
  id          Int      @id @default(autoincrement())
  name        String   // Tên khoản trừ (xăng dầu, thuê xe, thuê sân, phạt...)
  code        String?  // Mã khoản trừ
  description String?
  isDefault   Boolean  @default(false)
  defaultAmount Float? @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deductions  AdvancePaymentDeduction[]
}

model AdvancePolicyConfig {
  id                     Int      @id @default(autoincrement())
  maxAdvancePercent      Float    @default(70) // % tạm ứng tối đa cho phép (VD: 70%)
  maxAdvanceTimes        Int      @default(3)  // Số lần tối đa được tạm ứng trong 1 khóa
  guidelines             String?  // Hướng dẫn / Quy định chi tiết của kế toán
  isActive               Boolean  @default(true)
  updatedAt              DateTime @updatedAt
}

model AdvancePaymentRequest {
  id                  Int       @id @default(autoincrement())
  requestCode         String    @unique // Mã phiếu (VD: TU-202611-001)
  teacherId           Int
  teacher             User      @relation(fields: [teacherId], references: [id])
  courseId            Int
  course              Course    @relation(fields: [courseId], references: [id])
  studentCount        Int       @default(0) // Số học viên GV phụ trách trong khóa
  grossEstimatedAmount Float    @default(0) // Tổng thù lao ước tính từ các học viên
  maxAllowedAmount    Float     @default(0) // Mức tạm ứng tối đa được phép theo quy định
  totalDeductions     Float     @default(0) // Tổng các khoản giảm trừ
  requestedAmount     Float     @default(0) // Số tiền giáo viên đề nghị tạm ứng
  approvedAmount      Float?    // Số tiền kế toán duyệt thực tế
  status              String    @default("PENDING") // PENDING (Chờ duyệt), APPROVED (Đã duyệt), REJECTED (Từ chối), PAID (Đã chi tiền)
  reason              String?   // Lý do tạm ứng / Ghi chú của giáo viên
  accountantNotes     String?   // Ý kiến phản hồi / ghi chú của kế toán
  paymentReference    String?   // Mã giao dịch / số UNC ngân hàng
  approvedBy          String?   // Tên hoặc username kế toán duyệt
  approvedAt          DateTime?
  paidAt              DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  deductions          AdvancePaymentDeduction[]

  @@index([teacherId])
  @@index([courseId])
  @@index([status])
}

model AdvancePaymentDeduction {
  id                  Int                @id @default(autoincrement())
  requestId           Int
  request             AdvancePaymentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  deductionCategoryId Int?
  deductionCategory   DeductionCategory? @relation(fields: [deductionCategoryId], references: [id], onDelete: SetNull)
  name                String             // Tên khoản trừ
  amount              Float              @default(0) // Số tiền trừ
  note                String?
  createdAt           DateTime           @default(now())

  @@index([requestId])
}

// Cấu hình tỉ lệ % hưởng thù lao riêng biệt cho từng Giáo viên
model TeacherRateConfig {
  id                 Int      @id @default(autoincrement())
  teacherId          Int
  teacher            User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  courseId           Int?     // null nghĩa là áp dụng chung cho mọi khóa của giáo viên này
  course             Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  transmissionType   String?  // null nghĩa là áp dụng cả số sàn & tự động, hoặc 'AUTO' | 'MANUAL'
  scheduleType       String?  // null nghĩa là áp dụng cả ngày thường & cuối tuần, hoặc 'WEEKDAY' | 'SUNDAY'
  ratePercent        Float    @default(0) // Tỉ lệ % được hưởng (VD: 65 = 65%)
  note               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([teacherId, courseId, transmissionType, scheduleType])
  @@index([teacherId])
  @@index([courseId])
}
